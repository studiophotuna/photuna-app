<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Canon camera helper. Runs as a long-lived child process of the booth app and
    speaks line-delimited JSON over stdin/stdout. Kept out of the Electron process
    on purpose: camera SDKs are native code, and if one crashes or hangs only this
    process dies — the booth kills it, restarts it, and falls back to the webcam.

    Same shape as photo-print-helper so it builds and ships the same way.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>canon-camera-helper</AssemblyName>
    <RootNamespace>CanonCameraHelper</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Camera makers' SDKs are unpacked under sdk/ (git-ignored, licensed to the
    business). Their sample code must never be compiled in by the default **/*.cs
    glob; each backend includes exactly the wrapper files it needs.
  -->
  <ItemGroup>
    <Compile Remove="sdk/**" />
    <None Remove="sdk/**" />
  </ItemGroup>

  <!--
    Nikon Remote SDK v2 (Z series). Copied next to the helper, into nikon/, only when
    the business's SDK has been unpacked under sdk/nikon; builds without it still
    succeed and the Nikon backend reports the SDK as unavailable.
  -->
  <PropertyGroup>
    <NikonSdkBin>sdk\nikon\S-SDKZ-200BF-ALLIN\Module\Win\BinaryFile\</NikonSdkBin>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NikonSdkBin)ControlServiceLayer.dll')">
    <NikonSdkFile Include="$(NikonSdkBin)ControlServiceLayer.dll;$(NikonSdkBin)NkdPTP.dll;$(NikonSdkBin)dnssd.dll;$(NikonSdkBin)NkRoyalmile.dll;$(NikonSdkBin)DC_PTP_Config.config;$(NikonSdkBin)MaidLayer.config;$(NikonSdkBin)RangeValue.config" />
    <None Include="@(NikonSdkFile)" Link="nikon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    Nikon's per-model MAID modules (TypeXXXX.md3) for the D-series DSLRs and the older
    mirrorless bodies, from the same sdk/nikon download. They go into nikon/ beside the
    Remote SDK v2 files on purpose: a module resolves its own imports (NkdPTP.dll,
    dnssd.dll, NkRoyalmile.dll) from the folder it sits in, and those three are the same
    version in every one of Nikon's SDK folders, so one copy serves all of them.

    One module covers a family of cameras, so the same TypeXXXX.md3 ships in several of
    Nikon's per-model folders (Type0001 is the D3, D300, D300S, D3S and D700). Those
    copies are identical, but publish refuses two items that land on one path
    (NETSDK1152), so the modules are copied into place by a target instead of being
    declared as None items. A build without the SDK matches nothing here and still
    succeeds; the backend then reports the SDK as unavailable.
  -->
  <ItemGroup>
    <NikonMaidModuleFile Include="sdk\nikon\**\Module\Win\Binary Files\x64\Type*.md3" />
  </ItemGroup>
  <Target Name="CopyNikonMaidModulesToOutput" AfterTargets="Build">
    <Copy SourceFiles="@(NikonMaidModuleFile)"
          DestinationFiles="@(NikonMaidModuleFile->'$(OutDir)nikon\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNikonMaidModulesToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(NikonMaidModuleFile)"
          DestinationFiles="@(NikonMaidModuleFile->'$(PublishDir)nikon\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Canon EOS Digital SDK (EDSDK), 64-bit. Copied next to the helper, into canon/,
    only when the business's SDK has been unpacked under sdk/canon.
  -->
  <PropertyGroup>
    <CanonSdkBin>sdk\canon\Windows\EDSDK_64\Dll\</CanonSdkBin>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(CanonSdkBin)EDSDK.dll')">
    <CanonSdkFile Include="$(CanonSdkBin)EDSDK.dll;$(CanonSdkBin)EdsImage.dll" />
    <None Include="@(CanonSdkFile)" Link="canon\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    Sony Camera Remote SDK. Copied next to the helper, into sony/, only when both the
    business's SDK (sdk/sony/RemoteCli) and Photuna's bridge DLL (built by
    scripts/build-sony-bridge.ps1 into sdk/_build) are present.
  -->
  <PropertyGroup>
    <SonySdkBin>sdk\sony\RemoteCli\external\crsdk\</SonySdkBin>
    <SonyBridgeDll>sdk\_build\sony-bridge\Release\photuna_sony_bridge.dll</SonyBridgeDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(SonyBridgeDll)') And Exists('$(SonySdkBin)Cr_Core.dll')">
    <SonySdkFile Include="$(SonyBridgeDll);$(SonySdkBin)Cr_Core.dll;$(SonySdkBin)monitor_protocol.dll;$(SonySdkBin)monitor_protocol_pf.dll" />
    <SonyAdapterFile Include="$(SonySdkBin)CrAdapter\*.dll" />
    <None Include="@(SonySdkFile)" Link="sony\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="@(SonyAdapterFile)" Link="sony\CrAdapter\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
